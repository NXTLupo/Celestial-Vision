# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored — never commit real credentials.

# Google Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# APPLAUSE photographic plate archive token — request from https://www.plate-archive.org/
APPLAUSE_TOKEN=

# Astrometry.net plate-solving key — get free at https://nova.astrometry.net/api_help
ASTROMETRY_API_KEY=
